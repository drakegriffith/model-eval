+  ): void {
     const existing = this.items.get(productId);
     if (existing) {
       existing.quantity += quantity;
     } else {
       this.items.set(productId, { productId, unitPriceCents, quantity });
     }
+    // Last-call-wins: whatever discountTiers this call passed (including
