+// A bulk quantity discount: at `quantity >= minQuantity`, `offFraction` is
+// taken off that line (e.g. { minQuantity: 5, offFraction: 0.10 } == 10%
+// off once 5 or more units are in the cart for that product).
+export interface DiscountTier {
+  minQuantity: number;
+  offFraction: number;
+}
+
+// Rounds a non-negative number half-up to the nearest integer, e.g.
+// 4495.5 -> 4496 (not 4495 as a plain floor/truncation would give).
+function roundHalfUp(x: number): number {
+  return Math.floor(x + 0.5);
+}
+
+// Picks the single best-matching tier for a given quantity: the highest
+// minQuantity tier whose minQuantity <= quantity. Tiers are never
+// stacked/combined. Returns undefined if no tier qualifies.
+function bestTier(tiers: DiscountTier[], quantity: number): DiscountTier | undefined {
+  let best: DiscountTier | undefined;
+  for (const tier of tiers) {
+    if (tier.minQuantity <= quantity) {
+      if (!best || tier.minQuantity > best.minQuantity) {
+        best = tier;
+      }
+    }
+  }
+  return best;
+}
+
 export class Cart {
   private items = new Map<string, LineItem>();
+  private tiers = new Map<string, DiscountTier[]>();
 
-  addItem(productId: string, unitPriceCents: number, quantity: number): void {
