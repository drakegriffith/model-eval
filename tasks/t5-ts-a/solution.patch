+/** Sort ascending by the SCHED-88 rank order. Fresh array, fresh objects. */
+export function sortIntervals(xs: Interval[]): Interval[] {
+  return xs
+    .map((iv) => ({ start: iv.start, end: iv.end }))
+    .sort(ascending(compare));
+}
+
+/** Merge overlapping AND adjacent intervals into the minimal covering set. */
+export function merge(xs: Interval[]): Interval[] {
+  const sorted = sortIntervals(xs);
+  const out: Interval[] = [];
+  for (const iv of sorted) {
+    const last = out[out.length - 1];
+    // Rule 4: overlapping, or adjacent with no minute between them.
+    if (last !== undefined && iv.start <= last.end + 1) {
+      if (iv.end > last.end) last.end = iv.end;
+      continue;
+    }
+    out.push({ start: iv.start, end: iv.end });
+  }
+  return out;
 }
 
